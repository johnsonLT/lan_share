{
  "name": "lan-share-desktop",
  "version": "1.0.3",
  "description": "局域网文件互传 - 电脑端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bump-version": "node bump-version.js",
    "predist": "npm run bump-version",
    "dist": "electron-builder --win",
    "predist:portable": "npm run bump-version",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-store": "^8.1.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "build": {
    "appId": "com.lanshare.desktop",
    "productName": "LanShare",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "shared/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
